# gitignore 는 줄 끝 주석을 지원하지 않는다.
# "*.zip  # 설명" 처럼 쓰면 그 전체가 패턴이 되어 아무것도 안 걸러진다.
# 그래서 주석은 반드시 자기 줄에 따로 쓴다.

# 공개하면 안 되는 것 — 카카오 공식 안내서 등 저작물
*.zip
*.7z
*.rar

# 공개하면 안 되는 것 — 보고서, 안내 자료
*.docx
*.hwp
*.hwpx
*.pdf

# 생성 결과물 (매번 다시 만들 수 있다)
integration_out/
control_out/
motion_out/
effect_out/
*.gif
*.webp
generated_*.png
frames_*/

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# 비밀
.env
*.key
api*.txt

# 편집기 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
